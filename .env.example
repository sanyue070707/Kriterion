# ── Application ──
APP_NAME=Kriterion
DEBUG=true

# ── LLM ──
# Set LLM_PROVIDER to "qwen" to use Qwen3-Max, or "mock" for demo without API key
LLM_PROVIDER=mock
QWEN_API_KEY=
QWEN_MODEL_NAME=qwen-max

# ── Embedding & Reranker ──
# Set to "local" to use local BGE-M3/bge-reranker-v2-m3, or "mock" for random vectors
EMBEDDING_PROVIDER=mock
RERANKER_PROVIDER=mock
BGE_M3_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kriterion
POSTGRES_USER=kriterion
POSTGRES_PASSWORD=kriterion_dev
DATABASE_URL=postgresql+asyncpg://kriterion:kriterion_dev@postgres:5432/kriterion

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Milvus ──
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ── Langfuse (optional) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false
